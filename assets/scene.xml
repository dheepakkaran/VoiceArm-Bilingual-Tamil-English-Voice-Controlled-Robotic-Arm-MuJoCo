<mujoco model="voicearm_scene">
  <include file="mujoco_menagerie/franka_emika_panda/panda.xml"/>

  <!-- must come after the include so it overrides panda.xml's relative meshdir -->
  <compiler meshdir="mujoco_menagerie/franka_emika_panda/assets"
            texturedir="mujoco_menagerie/franka_emika_panda/assets"/>

  <statistic center="0.45 0 0.45" extent="1.1"/>

  <visual>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.22 0.22 0.22" specular="0 0 0"/>
    <global azimuth="150" elevation="-25" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.33 0.42" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.22 0.24 0.26" rgb2="0.28 0.30 0.32" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.1"/>
    <material name="tabletop"  rgba="0.42 0.36 0.30 1"/>
    <material name="mat_red"   rgba="0.85 0.12 0.12 1"/>
    <material name="mat_green" rgba="0.12 0.70 0.20 1"/>
    <material name="mat_blue"  rgba="0.12 0.30 0.88 1"/>
    <material name="mat_bowl"  rgba="0.90 0.90 0.93 1" specular="0.3"/>
  </asset>

  <default>
    <default class="block">
      <geom type="box" size="0.02 0.02 0.02" mass="0.05"
            friction="1.2 0.02 0.001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </default>
    <default class="bowlwall">
      <geom type="box" material="mat_bowl" friction="0.6 0.005 0.0001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.4 0 2.2" dir="0 0 -1" directional="true" diffuse="0.35 0.35 0.35"/>
    <light pos="1.2 -0.8 1.6" dir="-0.5 0.4 -1" diffuse="0.3 0.3 0.3"/>

    <geom name="floor" type="plane" size="3 3 0.05" material="groundplane"/>

    <!-- table: top surface at z = 0.40 -->
    <body name="table" pos="0.55 0 0.20">
      <geom name="table_top" type="box" size="0.30 0.40 0.20" material="tabletop"
            friction="0.8 0.01 0.0001"/>
    </body>

    <!-- Overhead camera. Frame z = x_cam cross y_cam = +Z, so it looks straight
         down. Axes are rotated so the image's wide dimension covers the table's
         wide dimension (world y), which keeps the whole worktop in frame. -->
    <camera name="topcam" pos="0.52 0 1.05" xyaxes="0 1 0 -1 0 0" fovy="45" mode="fixed"/>

    <!-- Angled demo camera. `targetbody` keeps it aimed at the table without
         hand-computing xyaxes. -->
    <camera name="scenecam" pos="1.45 -1.05 1.15" mode="targetbody" target="table" fovy="42"/>

    <!-- Perception fallback view. Straight down, a bowl is only a ring and OWLv2
         will not match it against any bowl-like query; from an angle it scores
         0.29. Objects whose top face is diagnostic still ground more accurately
         from `topcam`, so `locate()` tries that first and only falls back here. -->
    <camera name="perceptcam" pos="0.55 -0.55 0.85" mode="targetbody" target="table" fovy="50"/>

    <body name="red_block" pos="0.42 -0.18 0.421">
      <freejoint name="red_free"/>
      <geom name="red_geom" class="block" material="mat_red"/>
    </body>
    <body name="green_block" pos="0.42 0.00 0.421">
      <freejoint name="green_free"/>
      <geom name="green_geom" class="block" material="mat_green"/>
    </body>
    <body name="blue_block" pos="0.42 0.18 0.421">
      <freejoint name="blue_free"/>
      <geom name="blue_geom" class="block" material="mat_blue"/>
    </body>

    <!-- Round open bowl: a ring of 16 thin boxes. A square container reads as a
         white square from overhead and OWLv2 never matched it against "a white
         bowl"; the round profile is what makes the query land. Segment rotations are
         given as quaternions because panda.xml sets compiler angle="radian",
         which would silently reinterpret euler degrees. -->
    <body name="bowl" pos="0.60 0.00 0.40">
      <geom name="bowl_base" type="cylinder" material="mat_bowl" pos="0 0 0.005"
            size="0.0750 0.005" friction="0.6 0.005 0.0001"/>
      <geom name="bowl_w00" class="bowlwall" pos="0.0750 0.0000 0.0250" size="0.0030 0.0169 0.0250" quat="1.000000 0 0 0.000000"/>
      <geom name="bowl_w01" class="bowlwall" pos="0.0693 0.0287 0.0250" size="0.0030 0.0169 0.0250" quat="0.980785 0 0 0.195090"/>
      <geom name="bowl_w02" class="bowlwall" pos="0.0530 0.0530 0.0250" size="0.0030 0.0169 0.0250" quat="0.923880 0 0 0.382683"/>
      <geom name="bowl_w03" class="bowlwall" pos="0.0287 0.0693 0.0250" size="0.0030 0.0169 0.0250" quat="0.831470 0 0 0.555570"/>
      <geom name="bowl_w04" class="bowlwall" pos="0.0000 0.0750 0.0250" size="0.0030 0.0169 0.0250" quat="0.707107 0 0 0.707107"/>
      <geom name="bowl_w05" class="bowlwall" pos="-0.0287 0.0693 0.0250" size="0.0030 0.0169 0.0250" quat="0.555570 0 0 0.831470"/>
      <geom name="bowl_w06" class="bowlwall" pos="-0.0530 0.0530 0.0250" size="0.0030 0.0169 0.0250" quat="0.382683 0 0 0.923880"/>
      <geom name="bowl_w07" class="bowlwall" pos="-0.0693 0.0287 0.0250" size="0.0030 0.0169 0.0250" quat="0.195090 0 0 0.980785"/>
      <geom name="bowl_w08" class="bowlwall" pos="-0.0750 0.0000 0.0250" size="0.0030 0.0169 0.0250" quat="0.000000 0 0 1.000000"/>
      <geom name="bowl_w09" class="bowlwall" pos="-0.0693 -0.0287 0.0250" size="0.0030 0.0169 0.0250" quat="-0.195090 0 0 0.980785"/>
      <geom name="bowl_w10" class="bowlwall" pos="-0.0530 -0.0530 0.0250" size="0.0030 0.0169 0.0250" quat="-0.382683 0 0 0.923880"/>
      <geom name="bowl_w11" class="bowlwall" pos="-0.0287 -0.0693 0.0250" size="0.0030 0.0169 0.0250" quat="-0.555570 0 0 0.831470"/>
      <geom name="bowl_w12" class="bowlwall" pos="-0.0000 -0.0750 0.0250" size="0.0030 0.0169 0.0250" quat="-0.707107 0 0 0.707107"/>
      <geom name="bowl_w13" class="bowlwall" pos="0.0287 -0.0693 0.0250" size="0.0030 0.0169 0.0250" quat="-0.831470 0 0 0.555570"/>
      <geom name="bowl_w14" class="bowlwall" pos="0.0530 -0.0530 0.0250" size="0.0030 0.0169 0.0250" quat="-0.923880 0 0 0.382683"/>
      <geom name="bowl_w15" class="bowlwall" pos="0.0693 -0.0287 0.0250" size="0.0030 0.0169 0.0250" quat="-0.980785 0 0 0.195090"/>
      <site name="bowl_center" pos="0 0 0.06" size="0.005" rgba="1 1 0 0"/>
    </body>
  </worldbody>
</mujoco>
